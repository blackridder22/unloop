[
  {
    "id": 1,
    "priority": 1,
    "action": {
      "type": "redirect",
      "redirect": {
        "extensionPath": "/search.html"
      }
    },
    "condition": {
      "requestDomains": [
        "youtube.com",
        "youtu.be",
        "youtube-nocookie.com"
      ],
      "resourceTypes": [
        "main_frame"
      ],
      "excludedRequestDomains": [
        "music.youtube.com"
      ]
    }
  },
  {
    "id": 2,
    "priority": 2,
    "action": {
      "type": "allow"
    },
    "condition": {
      "regexFilter": "^https?://(www\\.|m\\.)?youtube\\.com/(watch|results|playlist)\\?",
      "resourceTypes": [
        "main_frame"
      ]
    }
  },
  {
    "id": 3,
    "priority": 2,
    "action": {
      "type": "allow"
    },
    "condition": {
      "regexFilter": "^https?://(www\\.|m\\.)?youtube\\.com/(@[^/?#]+|(channel|c|user)/[^/?#]+)(/(videos|streams|playlists|featured))?/?(\\?[^#]*)?$",
      "resourceTypes": [
        "main_frame"
      ]
    }
  },
  {
    "id": 4,
    "priority": 3,
    "action": {
      "type": "redirect",
      "redirect": {
        "regexSubstitution": "https://www.youtube.com/watch?v=\\1"
      }
    },
    "condition": {
      "regexFilter": "^https?://youtu\\.be/([a-zA-Z0-9_-]{11})(\\?.*)?$",
      "resourceTypes": [
        "main_frame"
      ]
    }
  },
  {
    "id": 5,
    "priority": 2,
    "action": {
      "type": "allow"
    },
    "condition": {
      "regexFilter": "^https?://(www\\.|m\\.)?youtube\\.com/redirect\\?",
      "resourceTypes": [
        "main_frame"
      ]
    }
  }
]
